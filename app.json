{
  "expo": {
    "name": "Noviq",
    "slug": "noviq-document-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "noviq",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.shelembestudios.noviq",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shelembestudios.noviq"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
"plugins": [
  "expo-router",
  "expo-font",
  "expo-web-browser",

  [
    "expo-splash-screen",
    {
      "image": "./assets/images/splash3.png",
      "resizeMode": "cover",
      "backgroundColor": "#2563EB"
    }
  ],

  [
    "expo-camera",
    {
      "cameraPermission": "Allow Noviq to access your camera to scan documents and QR codes."
    }
  ],

  [
    "expo-image-picker",
    {
      "photosPermission": "Allow Noviq to access your photo library to import images as scan pages."
    }
  ]
],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62e330d1-6bb3-44bb-9c33-cffec90ed15b"
      }
    }
  }
}
